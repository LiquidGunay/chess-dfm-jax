{
  "project_id": "your-gcp-project",
  "run_id": "jepa-profile-example",
  "run_name": "jepa-profile-example",
  "zone_order": [
    "europe-west4-b",
    "us-central1-a"
  ],
  "bucket_by_region": {
    "us-central1": "gs://your-us-central1-bucket",
    "europe-west4": "gs://your-europe-west4-bucket"
  },
  "wandb_project": "chess_dfm_jax-jepa",
  "wandb_group": "bt4-token-jepa",
  "accelerator_type": "v5litepod-16",
  "runtime_version": "tpu-ubuntu2204-base",
  "service_account": "tpu-trainer@your-gcp-project.iam.gserviceaccount.com",
  "network": "default",
  "subnetwork_by_zone": {
    "us-central1-a": "projects/your-gcp-project/regions/us-central1/subnetworks/default",
    "europe-west4-b": "projects/your-gcp-project/regions/europe-west4/subnetworks/default"
  },
  "enable_external_ips": true,
  "autocheckpoint_enabled": true,
  "allocation_timeout_s": 900,
  "poll_interval_s": 30,
  "workdir": "/tmp/chess_dfm_jax",
  "models_uri_by_region": {
    "us-central1": "gs://your-us-central1-bucket/models",
    "europe-west4": "gs://your-europe-west4-bucket/models"
  },
  "entry_command": "/tmp/venv/bin/python scripts/profile_jepa_tpu.py --out-dir /tmp/chess_dfm_jax/artifacts/profile_bundle --compute-dtype bfloat16 --head-param-dtype float32 --head-compute-dtype bfloat16 --trace-batch-size 1024 --trace-token-dim 512 --trace-num-layers 4 --trace-num-heads 8 --trace-mlp-dim 2048 --sweep-batch-sizes 256,512,1024 --sweep-token-dims 256,512,1024 --sweep-mlp-dims 1024,2048,4096 --num-layers 4 --num-heads 8 --warmup 1 --repeat 5",
  "env": {}
}
