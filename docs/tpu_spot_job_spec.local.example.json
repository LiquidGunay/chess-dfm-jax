{
  "project_id": "your-gcp-project",
  "run_id": "jepa-sequence-local",
  "run_name": "jepa-sequence-local",
  "run_family": "jepa",
  "zone_order": [
    "us-central1-a",
    "europe-west4-b"
  ],
  "bucket_by_region": {
    "us-central1": "gs://your-us-central1-bucket",
    "europe-west4": "gs://your-europe-west4-bucket"
  },
  "wandb_entity": "your-wandb-entity",
  "wandb_project": "chess_dfm_jax-jepa",
  "wandb_group": "bt4-token-jepa",
  "wandb_run_id": "jepa-sequence-local",
  "accelerator_type": "v5litepod-8",
  "runtime_version": "tpu-ubuntu2204-base",
  "service_account": "tpu-trainer@your-gcp-project.iam.gserviceaccount.com",
  "network": "default",
  "subnetwork_by_zone": {
    "us-central1-a": "projects/your-gcp-project/regions/us-central1/subnetworks/default",
    "europe-west4-b": "projects/your-gcp-project/regions/europe-west4/subnetworks/default"
  },
  "enable_external_ips": true,
  "autocheckpoint_enabled": true,
  "allocation_timeout_s": 1800,
  "poll_interval_s": 30,
  "workdir": "/tmp/chess_dfm_jax",
  "cache_disk_by_zone": {},
  "cache_disk_mode": "read-write",
  "cache_mount_point": "/mnt/chess-dfm-cache",
  "keep_resource_on_completion": false,
  "keep_resource_on_failure": false,
  "models_uri_by_region": {
    "us-central1": "gs://your-us-central1-bucket/models",
    "europe-west4": "gs://your-europe-west4-bucket/models"
  },
  "chunk_data_uri_by_region": {
    "us-central1": "gs://your-us-central1-bucket/chunks/trajectory-v2-example",
    "europe-west4": "gs://your-europe-west4-bucket/chunks/trajectory-v2-example"
  },
  "train_args": {
    "steps": 50000,
    "batch-size": 64,
    "save-every": 100,
    "log-every": 10,
    "encoder-dtype": "bfloat16",
    "head-param-dtype": "float32",
    "head-compute-dtype": "bfloat16",
    "token-dim": 256,
    "num-layers": 4,
    "num-heads": 8,
    "mlp-dim": 1024,
    "action-source": "best",
    "terminal-only": false
  },
  "env": {},
  "secret_env": {}
}
